#!/usr/bin/env bash
# Foolproof Terraform wrapper: guarantees every AWS call goes to Floci.
# Run it from inside an experiment directory (each experiment is its own root):
#   cd experiments/sns-to-sqs && ./tf init && ./tf apply
# (Each experiment dir has a `tf` symlink to this script.)
set -euo pipefail

export AWS_ENDPOINT_URL="${AWS_ENDPOINT_URL:-http://localhost:4566}"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"

# Run terraform in the CURRENT directory (the experiment root), not the project root.
exec terraform "$@"
